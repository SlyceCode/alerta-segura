# Plantilla de variables de entorno. Copiar a .env y ajustar.
# En Render estas mismas claves se cargan desde el panel del servicio.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_ADMIN_PATH=admin/

# --- Servicios ------------------------------------------------------------
DATABASE_URL=postgres://alerta:alerta@localhost:5432/alerta
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=False

# --- Identidad del despliegue --------------------------------------------
# APP_COMMIT lo devuelve /health/ y lo valida scripts/smoke.sh.
# En Render se toma solo de RENDER_GIT_COMMIT.
APP_ENV=local
APP_VERSION=0.1.0
APP_COMMIT=local
LOG_LEVEL=INFO

# --- Politica de salida a internet (RNF-04) -------------------------------
DESTINOS_ESQUEMAS=http,https
DESTINOS_PUERTOS=80,443
DESTINOS_PERMITIR_PRIVADOS=False
DESTINOS_TIMEOUT=10
DESTINOS_MAX_REDIRECCIONES=3

# --- Solo produccion ------------------------------------------------------
# DJANGO_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DB_SSL_REQUIRED=True
# EMAIL_HOST=
